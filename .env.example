GSB_API_KEY=
# VirusTotal: https://www.virustotal.com/gui/my-apikey  (free tier: 4 req/min)
VT_API_KEY=
# urlscan.io (optional, for screenshotting live pages)
URLSCAN_API_KEY=

# ---- runtime ----
PORT=8000
